{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MechVis: Start App",
      "type": "shell",
      "command": "\"${workspaceFolder}/scripts/mechvis.sh\" start --open",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "MechVis: Run Checks",
      "type": "shell",
      "command": "\"${workspaceFolder}/scripts/mechvis.sh\" check",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      }
    }
  ]
}
